---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE, SOCIAL_LINKS } from "@/consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="Software engineer building reliable data infrastructure, systems, and tools." />
	</head>
	<body>
		<Header />
		<main id="main-content" class="focused-page about-page">
			<header class="page-intro">
				<p class="page-label">01 / About</p>
				<h1>Build carefully.<br />Keep it useful.</h1>
				<p>I’m a software engineer working on data infrastructure, systems, and developer tools. I care about the hard parts beneath a product: reliability, clarity, and making complex platforms easier to use.</p>
			</header>

			<section class="principles" aria-labelledby="principles-title">
				<h2 id="principles-title">How I work</h2>
				<ol>
					<li><strong>Understand the problem first.</strong> Good implementation starts with the real constraint, not the first available tool.</li>
					<li><strong>Prefer simple systems.</strong> The right amount of boring in production is usually more valuable than cleverness.</li>
					<li><strong>Make platforms pleasant to use.</strong> Developer experience, documentation, and self-service are part of the system.</li>
					<li><strong>Leave a useful signal behind.</strong> Decisions should be understandable long after the implementation is done.</li>
				</ol>
			</section>

			<section class="outside-work" aria-labelledby="outside-title">
				<h2 id="outside-title">Outside work</h2>
				<p>I <a href="/music">listen to a lot of music</a>, take photos, train, and keep an unreasonable number of books around. Those interests tend to return to the same things I value in software: structure, rhythm, and attention to detail.</p>
			</section>

			<nav class="contact-links" aria-label="Contact and profiles">
				<a href={`mailto:${SOCIAL_LINKS.email}`}>Email ↗</a>
				<a href={SOCIAL_LINKS.github}>GitHub ↗</a>
				<a href={SOCIAL_LINKS.linkedin}>LinkedIn ↗</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.focused-page { width: min(850px, calc(100% - 48px)); margin: auto; }
	.page-intro { padding: clamp(60px, 11vw, 140px) 0 clamp(64px, 10vw, 120px); }
	.page-label, .principles h2, .outside-work h2 { margin: 0; color: var(--sand); font: 400 10px/1.5 "Silkscreen", var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
	.page-intro h1 { max-width: 10ch; margin: 28px 0; font: 400 clamp(48px, 7.8vw, 92px)/.96 "Silkscreen", var(--font-mono); letter-spacing: -.06em; text-transform: uppercase; }
	.page-intro > p:last-child { max-width: 54ch; margin: 0; color: var(--text-secondary); font-size: clamp(17px, 2vw, 21px); line-height: 1.65; }
	.principles, .outside-work { padding-top: 22px; border-top: 1px solid var(--border-color); }
	.principles ol { padding: 0; margin: 30px 0 0; list-style: none; }
	.principles li { padding: 18px 0; border-bottom: 1px solid var(--border-color); color: var(--text-secondary); }
	.principles strong { color: var(--text-primary); }
	.outside-work { margin-top: 76px; }
	.outside-work p { max-width: 60ch; margin: 28px 0 0; }
	.outside-work a { color: var(--text-primary); text-decoration: underline; text-decoration-color: var(--border-light); text-underline-offset: 4px; }
	.contact-links { display: flex; flex-wrap: wrap; gap: 20px; margin: 76px 0 0; padding: 20px 0; border-top: 1px solid var(--border-color); }
	.contact-links a { color: var(--text-primary); font: 400 10px/1.5 "Silkscreen", var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
	.contact-links a:hover { color: var(--sand); }
	@media (max-width: 640px) { .focused-page { width: calc(100% - 32px); } .page-intro { padding-block: 65px; } .page-intro h1 { font-size: clamp(36px, 10vw, 58px); } .outside-work { margin-top: 56px; } .contact-links { margin-top: 56px; } }
</style>
