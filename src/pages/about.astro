---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";
import * as about from "@/content/about.md";

const { Content, frontmatter } = about;

const timeline = [
	{
		country: "Spain",
		period: "1997 - 2021",
		note: "Origin, education, early career",
	},
	{
		country: "Netherlands",
		period: "2021 - 2024",
		note: "Amsterdam, data engineering",
	},
	{
		country: "Japan",
		period: "2024 - now",
		note: "Tokyo, data platform engineering",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About - ${SITE_TITLE}`}
			description="About Adrian Villanueva Martinez, a software engineer building cloud-native data platforms from Tokyo."
		/>
	</head>
	<body>
		<Header />
		<main class="about-page">
			<header class="about-intro">
				<div class="intro-copy">
					<p class="eyebrow"><span>ABOUT / 01</span> PERSONAL DOSSIER</p>
					<h1>Adrian<br /><em>Villanueva.</em></h1>
					<p class="intro-lede">
						Software engineer interested in the systems beneath the surface:
						data platforms, infrastructure, developer experience, and the small
						details that make technology feel alive.
					</p>
					<div class="intro-links">
						<a href={`mailto:${frontmatter.email}`}>Email <span>-></span></a>
						<a href={frontmatter.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span>-></span></a>
						<a href={frontmatter.github} target="_blank" rel="noopener noreferrer">GitHub <span>-></span></a>
					</div>
				</div>
			</header>

			<section class="signal-path" aria-labelledby="signal-title">
				<div class="section-kicker"><span>02</span><h2 id="signal-title">The signal path</h2></div>
				<div class="timeline">
					{timeline.map((entry, index) => (
						<div class="timeline-entry">
							<div class="timeline-index">0{index + 1}</div>
							<div class="timeline-copy">
								<h3>{entry.country}</h3>
								<p>{entry.period}</p>
								<span>{entry.note}</span>
							</div>
						</div>
					))}
				</div>
			</section>

			<section class="about-essay" aria-labelledby="essay-title">
				<aside class="essay-aside">
					<span>03</span>
					<h2 id="essay-title">Notes from<br />the stack</h2>
				</aside>
				<article class="essay-content"><Content /></article>
			</section>

			<section class="closing-note" aria-label="Contact invitation">
				<p class="eyebrow"><span>04</span> OPEN CHANNEL</p>
				<p class="closing-copy">Difficult infrastructure, interesting data problems, or something slightly weird?</p>
				<a class="closing-link" href={`mailto:${frontmatter.email}`}>Say hello <span>-></span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		max-width: 1120px;
		margin: 0 auto;
		padding: 3rem 2rem 1rem;
	}

	.eyebrow,
	.section-kicker > span,
	.timeline-index,
	.timeline-copy p,
	.timeline-copy span,
	.essay-aside > span {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.68rem;
		letter-spacing: 0.12em;
	}

	.eyebrow {
		color: var(--text-muted);
	}

	.eyebrow span,
	.section-kicker > span,
	.timeline-index,
	.essay-aside > span {
		color: var(--accent-blog);
	}

	.about-intro {
		max-width: 760px;
		padding: 3rem 0 8rem;
	}

	.about-intro h1 {
		margin: 1.5rem 0;
		font-size: clamp(3rem, 7vw, 5.5rem);
		line-height: 0.88;
		letter-spacing: -0.07em;
	}

	.about-intro h1 em {
		font-style: normal;
		color: var(--accent-blog);
	}

	.intro-lede {
		max-width: 500px;
		color: var(--text-secondary);
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.intro-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}

	.intro-links a,
	.closing-link {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.75rem;
		color: var(--text-secondary);
	}

	.intro-links a span,
	.closing-link span {
		margin-left: 0.4rem;
		color: var(--accent-blog);
	}

	.section-kicker {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 2rem;
		border-top: 1px solid var(--border-color);
		padding-top: 1rem;
	}

	.section-kicker h2,
	.essay-aside h2 {
		margin: 0;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.9rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.timeline {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-bottom: 1px solid var(--border-color);
	}

	.timeline-entry {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		min-height: 180px;
		padding: 0 1.5rem 1.5rem 0;
		border-right: 1px solid var(--border-color);
	}

	.timeline-entry + .timeline-entry {
		padding-left: 1.5rem;
	}

	.timeline-entry:last-child {
		border-right: 0;
	}

	.timeline-copy h3 {
		margin: 0 0 0.5rem;
		font-family: "Cinzel", serif;
		font-size: clamp(1.3rem, 3vw, 2rem);
		font-weight: 600;
	}

	.timeline-copy p,
	.timeline-copy span {
		display: block;
		margin: 0;
		color: var(--text-muted);
	}

	.timeline-copy span {
		margin-top: 0.7rem;
		font-family: "Inter", sans-serif;
		font-size: 0.82rem;
		letter-spacing: 0;
		line-height: 1.5;
	}

	.about-essay {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(2rem, 10vw, 10rem);
		margin-top: 8rem;
	}

	.essay-aside > span {
		display: block;
		margin-bottom: 1rem;
	}

	.essay-aside h2 {
		font-size: clamp(1rem, 2vw, 1.4rem);
		line-height: 1.4;
	}

	.essay-content {
		max-width: 620px;
		color: var(--text-secondary);
		font-size: 1rem;
		line-height: 1.8;
	}

	.essay-content :global(h2) {
		margin: 3rem 0 1rem;
		font-family: "Cinzel", serif;
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--text-primary);
	}

	.essay-content :global(h2:first-child) {
		margin-top: 0;
	}

	.essay-content :global(strong) {
		color: var(--text-primary);
	}

	.essay-content :global(ul) {
		padding-left: 1.2rem;
	}

	.essay-content :global(li) {
		margin: 0.5rem 0;
	}

	.closing-note {
		max-width: 620px;
		margin: 8rem 0 2rem auto;
		border-top: 1px solid var(--border-color);
		padding-top: 1rem;
	}

	.closing-copy {
		margin: 1.5rem 0;
		font-family: "Cinzel", serif;
		font-size: clamp(1.5rem, 3vw, 2.4rem);
		line-height: 1.25;
	}

	.closing-link {
		color: var(--accent-blog);
	}

	@media (max-width: 700px) {
		.about-page {
			padding: 1.5rem 1rem 0;
		}

		.about-intro {
			padding: 2rem 0 5rem;
		}

		.about-intro h1 {
			font-size: clamp(3.5rem, 18vw, 6rem);
		}

		.timeline {
			grid-template-columns: 1fr;
		}

		.timeline-entry,
		.timeline-entry + .timeline-entry {
			min-height: 0;
			padding: 1rem 0;
			border-right: 0;
			border-bottom: 1px solid var(--border-color);
		}

		.timeline-entry:last-child {
			border-bottom: 0;
		}

		.about-essay {
			grid-template-columns: 1fr;
			gap: 2rem;
			margin-top: 5rem;
		}

		.closing-note {
			margin-top: 5rem;
		}
	}

</style>
