---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";
import * as uses from "@/content/uses.md";
type Item={name:string;desc?:string;specs?:string;category?:string;note?:string}; const { frontmatter }=uses; const {hardware,peripherals,software}=frontmatter as {hardware:Item[];peripherals:Item[];software:Item[]};
---
<!doctype html><html lang="en"><head><BaseHead title={`Uses — ${SITE_TITLE}`} description="Hardware and software Adrian Villanueva Martinez uses." /></head><body><Header /><main id="main-content" class="uses-page"><header><p>01 / Uses</p><h1>Tools I use.</h1><p>A small record of the hardware and software around my work.</p></header>{[["Hardware",hardware],["Peripherals",peripherals],["Software",software]].map(([title,items])=><section><h2>{title as string}</h2><dl>{(items as Item[]).map(item=><div><dt>{item.name}</dt><dd>{item.desc||item.category}{item.specs&&<small>{item.specs}</small>}{item.note&&<small>{item.note}</small>}</dd></div>)}</dl></section>)}</main><Footer /></body></html>
<style>.uses-page{width:min(850px,calc(100% - 48px));margin:auto}.uses-page header{padding:clamp(60px,11vw,140px) 0 80px;max-width:620px}.uses-page header>p:first-child,.uses-page h2{margin:0;color:var(--sand);font:400 10px/1.5 "Silkscreen",var(--font-mono);letter-spacing:.05em;text-transform:uppercase}.uses-page h1{margin:28px 0;font:400 clamp(48px,7.8vw,92px)/.96 "Silkscreen",var(--font-mono);letter-spacing:-.06em;text-transform:uppercase}.uses-page header>p:last-child{font-size:18px}.uses-page section{margin-top:70px;padding-top:20px;border-top:1px solid var(--border-color)}.uses-page dl{margin:20px 0 0}.uses-page dl>div{display:grid;grid-template-columns:220px 1fr;gap:22px;padding:16px 0;border-bottom:1px solid var(--border-color)}.uses-page dt{color:var(--text-primary);font-size:15px}.uses-page dd{margin:0;color:var(--text-secondary);font-size:14px}.uses-page small{display:block;margin-top:5px;color:var(--text-muted)}@media(max-width:640px){.uses-page{width:calc(100% - 32px)}.uses-page header{padding-block:65px}.uses-page h1{font-size:clamp(36px,10vw,58px)}.uses-page dl>div{grid-template-columns:1fr;gap:5px}}</style>
