---
import { Icon } from "astro-icon/components";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";
import * as uses from "@/content/uses.md";

const { Content, frontmatter } = uses;
const { hardware, peripherals, software } = frontmatter;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Uses - ${SITE_TITLE}`} description="The hardware, software, and tools Adrian Villanueva Martinez uses every day." />
	</head>
	<body>
		<Header />
		<main class="uses-page">
			<header class="page-intro">
				<p class="eyebrow"><span>USES / 01</span> TOOLS & ENVIRONMENT</p>
				<h1>Things I<br /><em>use.</em></h1>
				<p class="intro-copy">Hardware, software, and small decisions that shape how I work and make things.</p>
			</header>

			<section class="uses-section" aria-labelledby="hardware-title">
				<div class="section-kicker"><span>02</span><h2 id="hardware-title">Hardware</h2></div>
				<div class="uses-list">
					{hardware.map((item) => <div class="use-item"><Icon name={item.icon} size={18} /><div><h3>{item.name}</h3><p>{item.desc}</p><small>{item.specs}</small><div class="tags">{item.tags?.map((tag: string) => <span>{tag}</span>)}</div></div></div>)}
				</div>
			</section>

			<section class="uses-section" aria-labelledby="peripherals-title">
				<div class="section-kicker"><span>03</span><h2 id="peripherals-title">Peripherals</h2></div>
				<div class="peripherals-list">{peripherals.map((item) => <span><Icon name={item.icon} size={16} />{item.name}</span>)}</div>
			</section>

			<section class="uses-section" aria-labelledby="software-title">
				<div class="section-kicker"><span>04</span><h2 id="software-title">Software & environment</h2></div>
				<div class="software-list">
					{software.map((item) => <div class="software-item"><Icon name={item.icon} size={18} /><div><h3>{item.name}</h3><p>{item.category}</p>{item.note && <small>{item.note}</small>}</div></div>)}
				</div>
			</section>

			<section class="uses-notes" aria-label="Notes"><Content /></section>
			<p class="uses-footer">Last updated — {frontmatter.lastUpdated}. Follows the <a href="https://uses.tech" target="_blank" rel="noopener noreferrer">/uses movement</a>.</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.uses-page { max-width: 960px; margin: 0 auto; padding: 3rem 2rem 1rem; }
	.eyebrow, .section-kicker > span, .use-item small, .use-item .tags, .software-item small { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; letter-spacing: 0.12em; }
	.eyebrow { color: var(--text-muted); }
	.eyebrow span, .section-kicker > span { color: var(--accent-blog); }
	.page-intro { max-width: 700px; padding: 3rem 0 8rem; }
	.page-intro h1 { margin: 1.5rem 0; font-size: clamp(4rem, 10vw, 8rem); line-height: 0.88; letter-spacing: -0.07em; }
	.page-intro h1 em { font-style: normal; color: var(--accent-blog); }
	.intro-copy { max-width: 520px; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.7; }
	.uses-section + .uses-section { margin-top: 7rem; }
	.section-kicker { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2rem; border-top: 1px solid var(--border-color); padding-top: 1rem; }
	.section-kicker h2 { margin: 0; font-family: "JetBrains Mono", monospace; font-size: 0.9rem; letter-spacing: 0.04em; text-transform: uppercase; }
	.uses-list, .software-list { border-top: 1px solid var(--border-color); }
	.use-item, .software-item { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--border-color); }
	.use-item > :global(svg), .software-item > :global(svg) { color: var(--accent-blog); margin-top: 0.25rem; }
	.use-item h3, .software-item h3 { margin: 0; font-family: "Cinzel", serif; font-size: 1.25rem; font-weight: 600; }
	.use-item p, .software-item p { margin: 0.35rem 0 0; color: var(--text-secondary); line-height: 1.6; }
	.use-item small, .software-item small { display: block; margin-top: 0.5rem; color: var(--text-muted); letter-spacing: 0; line-height: 1.5; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; color: var(--accent-blog); letter-spacing: 0.04em; }
	.tags span { border-bottom: 1px solid var(--border-light); padding-bottom: 0.2rem; }
	.peripherals-list { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
	.peripherals-list span { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text-secondary); }
	.peripherals-list :global(svg) { color: var(--accent-blog); }
	.uses-notes { max-width: 620px; margin: 7rem 0 0 auto; color: var(--text-secondary); font-size: 1rem; line-height: 1.8; }
	.uses-notes :global(h2), .uses-notes :global(h3) { margin: 3rem 0 1rem; font-family: "Cinzel", serif; color: var(--text-primary); }
	.uses-notes :global(h2:first-child) { margin-top: 0; }
	.uses-footer { margin: 7rem 0 2rem; border-top: 1px solid var(--border-color); padding-top: 1rem; color: var(--text-muted); font-size: 0.85rem; }
	.uses-footer a { color: var(--accent-blog); }
	@media (max-width: 700px) { .uses-page { padding: 1.5rem 1rem 0; } .page-intro { padding: 2rem 0 5rem; } .page-intro h1 { font-size: clamp(3.5rem, 18vw, 6rem); } .uses-section + .uses-section { margin-top: 5rem; } }
</style>
