---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE, SOCIAL_LINKS } from "@/consts";
---
<!doctype html><html lang="en"><head><BaseHead title={`Contact — ${SITE_TITLE}`} description="Contact Adrian Villanueva Martinez about infrastructure, data systems, and technical collaboration." /></head><body><Header /><main id="main-content" class="contact-page"><header><p>01 / Contact</p><h1>Get in touch.</h1><p>For difficult infrastructure, useful systems, and technical work with room for care.</p></header><section aria-label="Contact details"><a href={`mailto:${SOCIAL_LINKS.email}`}><span>Email</span>{SOCIAL_LINKS.email} ↗</a><a href={SOCIAL_LINKS.linkedin}><span>LinkedIn</span>Adrian Villanueva Martinez ↗</a><a href={SOCIAL_LINKS.github}><span>GitHub</span>adrianvillanueva997 ↗</a></section></main><Footer /></body></html>
<style>.contact-page{width:min(850px,calc(100% - 48px));margin:auto}.contact-page header{padding:clamp(60px,11vw,140px) 0 80px;max-width:630px}.contact-page header>p:first-child,.contact-page a span{margin:0;color:var(--sand);font:400 10px/1.5 "Silkscreen",var(--font-mono);letter-spacing:.05em;text-transform:uppercase}.contact-page h1{margin:28px 0;font:400 clamp(48px,7.8vw,92px)/.96 "Silkscreen",var(--font-mono);letter-spacing:-.06em;text-transform:uppercase}.contact-page header>p:last-child{margin:0;font-size:18px}.contact-page section{border-top:1px solid var(--border-color)}.contact-page a{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:22px 0;border-bottom:1px solid var(--border-color);color:var(--text-primary);font:400 14px/1.5 var(--font-mono);overflow-wrap:anywhere}.contact-page a:hover{color:var(--sand)}@media(max-width:640px){.contact-page{width:calc(100% - 32px)}.contact-page header{padding-block:65px}.contact-page h1{font-size:clamp(36px,10vw,58px)}.contact-page a{grid-template-columns:1fr;gap:5px}}</style>
