---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";
import * as now from "@/content/now.md";

const { Content, frontmatter } = now;
const preview = frontmatter.preview;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Now — ${SITE_TITLE}`} description="What Adrian Villanueva Martinez is learning, reading, building, and thinking about now." />
	</head>
	<body>
		<Header />
		<main id="main-content" class="now-page">
			<header class="now-intro">
				<p>01 / Now</p>
				<h1>Current focus.</h1>
				<p>A short record of what I’m working through and returning to.</p>
				<small>Updated {frontmatter.lastUpdated}</small>
			</header>

			<section class="now-list" aria-label="Current interests">
				<p><span>Learning</span><strong>{preview.learning}</strong></p>
				<p><span>Reading</span><strong>{preview.reading}</strong></p>
				<p><span>Building</span><strong>{preview.building}</strong></p>
				<p><span>Focus</span><strong>{preview.focus}</strong></p>
				<p><span>Training</span><strong>{preview.training}</strong></p>
			</section>

			<article class="now-notes"><Content /></article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.now-page { width: min(850px, calc(100% - 48px)); margin: auto; }
	.now-intro { padding: clamp(60px, 11vw, 140px) 0 76px; }
	.now-intro > p:first-child, .now-intro small, .now-list span { margin: 0; color: var(--sand); font: 400 10px/1.5 "Silkscreen", var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
	.now-intro h1 { margin: 28px 0; font: 400 clamp(48px, 7.8vw, 92px)/.96 "Silkscreen", var(--font-mono); letter-spacing: -.06em; text-transform: uppercase; }
	.now-intro > p:nth-child(3) { max-width: 48ch; margin: 0 0 24px; color: var(--text-secondary); font-size: clamp(17px, 2vw, 21px); }
	.now-list { border-top: 1px solid var(--border-color); }
	.now-list p { display: grid; grid-template-columns: 130px 1fr; gap: 20px; padding: 17px 0; margin: 0; border-bottom: 1px solid var(--border-color); }
	.now-list strong { color: var(--text-primary); font-size: 15px; font-weight: 400; }
	.now-notes { max-width: 65ch; margin: 80px 0 0; }
	.now-notes :global(h2) { margin: 48px 0 14px; color: var(--text-primary); font: 400 clamp(23px, 3vw, 34px)/1.15 var(--font-body); }
	.now-notes :global(p) { color: var(--text-secondary); }
	.now-notes :global(a) { text-decoration: underline; text-decoration-color: var(--border-light); text-underline-offset: 4px; }
	@media (max-width: 640px) { .now-page { width: calc(100% - 32px); } .now-intro { padding-block: 65px; } .now-intro h1 { font-size: clamp(36px, 10vw, 58px); } .now-list p { grid-template-columns: 1fr; gap: 4px; } .now-notes { margin-top: 56px; } }
</style>
