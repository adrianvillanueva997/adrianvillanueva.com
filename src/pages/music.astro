---
import { readFileSync } from "node:fs";
import { load } from "js-yaml";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";

type Album = { title: string; artist: string; href: string; note?: string };
type Artist = { name: string; flag?: string };
const { period, lastUpdated, albums: albumEntries, artists } = load(readFileSync("src/data/music.yaml", "utf8")) as { period: string; lastUpdated: string; albums: Album[]; artists: Artist[] };
const albums = await Promise.all(albumEntries.map(async (album) => {
	try {
		const response = await fetch(`https://open.spotify.com/oembed?url=${encodeURIComponent(album.href)}`);
		if (!response.ok) return { ...album, cover: undefined };
		const metadata = await response.json() as { thumbnail_url?: string };
		if (!metadata.thumbnail_url) return { ...album, cover: undefined };
		const coverResponse = await fetch(metadata.thumbnail_url);
		if (!coverResponse.ok) return { ...album, cover: undefined };
		const type = coverResponse.headers.get("content-type") || "image/jpeg";
		return { ...album, cover: `data:${type};base64,${Buffer.from(await coverResponse.arrayBuffer()).toString("base64")}` };
	} catch { return { ...album, cover: undefined }; }
}));
---
<!doctype html><html lang="en"><head><BaseHead title={`Music — ${SITE_TITLE}`} description="Albums and artists Adrian Villanueva Martinez keeps returning to." /></head><body><Header /><main id="main-content" class="music-page"><header><p>01 / Listening</p><h1>In rotation.</h1><p>This is what I listen to, not music I make. {period} / Updated {lastUpdated}</p></header><section aria-labelledby="albums-title"><h2 id="albums-title">Albums</h2><div class="album-grid">{albums.map(album => <article>{album.cover && <img src={album.cover} alt={`Cover of ${album.title}`} loading="lazy" />}<div><h3><a href={album.href}>{album.title} ↗</a></h3><p class="artist">{album.artist}</p>{album.note && <p class="note">{album.note}</p>}</div></article>)}</div></section><section class="artists"><h2>Artists</h2><p>{artists.map(artist => <span>{artist.name}{artist.flag && ` ${artist.flag}`}</span>)}</p></section></main><Footer /></body></html>
<style>
.music-page{width:min(1000px,calc(100% - 48px));margin:auto}.music-page header{padding:clamp(60px,11vw,140px) 0 80px;max-width:640px}.music-page header>p:first-child,.music-page h2{margin:0;color:var(--sand);font:400 10px/1.5 "Silkscreen",var(--font-mono);letter-spacing:.05em;text-transform:uppercase}.music-page h1{margin:28px 0;font:400 clamp(48px,7.8vw,92px)/.96 "Silkscreen",var(--font-mono);letter-spacing:-.06em;text-transform:uppercase}.music-page header>p:last-child{font-size:17px}.music-page section{padding-top:20px;border-top:1px solid var(--border-color)}.album-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;margin-top:20px;background:var(--border-color)}.album-grid article{display:grid;grid-template-columns:120px 1fr;gap:18px;padding:14px;background:var(--bg-primary)}.album-grid img{display:block;width:120px;aspect-ratio:1;object-fit:cover}.album-grid h3{margin:3px 0 6px;font:500 20px/1.2 var(--font-body)}.album-grid h3 a{color:var(--text-primary)}.artist{margin:0;color:var(--sand);font-size:14px}.note{margin:15px 0 0;color:var(--text-muted);font-size:13px;line-height:1.5}.artists{margin-top:70px}.artists span{display:inline-block;margin:18px 18px 0 0;color:var(--text-secondary);font-size:14px}@media(max-width:760px){.music-page{width:calc(100% - 32px)}.music-page header{padding-block:65px}.music-page h1{font-size:clamp(36px,10vw,58px)}.album-grid{grid-template-columns:1fr}}@media(max-width:380px){.album-grid article{grid-template-columns:90px 1fr}.album-grid img{width:90px}}
</style>
