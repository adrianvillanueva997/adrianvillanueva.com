---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { load } from "js-yaml";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";

type Experience = {
	company: string;
	position: string;
	location: string;
	startDate: string;
	endDate: string;
	highlights: string[];
};
type Resume = {
	personal: { summary: string };
	experience: Experience[];
	skills: Record<string, string[]>;
};
const { personal, experience, skills } = load(readFileSync(join(process.cwd(), "src/data/resume.yaml"), "utf8")) as Resume;
const formatDate = (date: string) => date === "Present" ? date : new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(new Date(`${date}-01T00:00:00`));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Résumé — ${SITE_TITLE}`} description="Professional experience building data infrastructure, platforms, and developer tools." />
	</head>
	<body>
		<Header />
		<main id="main-content" class="resume-page">
			<header class="resume-intro">
				<p>01 / Résumé</p>
        <h1>My Experience <br /></h1>
				<div><p>{personal.summary}</p><a href="/resume.pdf" download>Download PDF ↗</a></div>
			</header>

			<section aria-labelledby="experience-title">
				<h2 id="experience-title">Work history</h2>
				<div class="experience-list">
					{experience.map((job) => <article class="experience-entry">
						<p class="date">{formatDate(job.startDate)} — {formatDate(job.endDate)}</p>
						<div>
							<h3>{job.position}</h3>
							<p class="company">{job.company} <span>/ {job.location}</span></p>
							<ul>{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
						</div>
					</article>)}
				</div>
			</section>

			<section class="capabilities" aria-labelledby="capabilities-title">
				<h2 id="capabilities-title">Capabilities</h2>
				<dl>{Object.entries(skills).map(([group, values]) => <div><dt>{group}</dt><dd>{values.join(" · ")}</dd></div>)}</dl>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.resume-page { width: min(1000px, calc(100% - 48px)); margin: auto; }
	.resume-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, .55fr); gap: 42px; padding: clamp(60px, 11vw, 140px) 0 100px; }
	.resume-intro > p, .resume-page h2, .date, .capabilities dt { margin: 0; color: var(--sand); font: 400 10px/1.5 "Silkscreen", var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
	.resume-intro h1 { grid-column: 1 / -1; max-width: 11ch; margin: 0; font: 400 clamp(45px, 7.5vw, 90px)/.98 "Silkscreen", var(--font-mono); letter-spacing: -.06em; text-transform: uppercase; }
	.resume-intro > div { grid-column: 2; }
	.resume-intro > div p { margin: 0 0 24px; color: var(--text-secondary); }
	.resume-intro a { color: var(--text-primary); font: 400 10px/1.5 "Silkscreen", var(--font-mono); letter-spacing: .04em; text-transform: uppercase; text-decoration: underline; text-decoration-color: var(--border-light); text-underline-offset: 6px; }
	.resume-page h2 { padding-top: 20px; border-top: 1px solid var(--border-color); }
	.experience-list { margin-top: 30px; }
	.experience-entry { display: grid; grid-template-columns: 160px 1fr; gap: 36px; padding: 0 0 52px; margin-bottom: 52px; border-bottom: 1px solid var(--border-color); }
	.experience-entry h3 { margin: 0; color: var(--text-primary); font: 500 clamp(23px, 3vw, 34px)/1.15 var(--font-body); letter-spacing: -.035em; }
	.company { margin: 8px 0 24px; color: var(--text-primary); font-size: 15px; }
	.company span { color: var(--text-muted); }
	.experience-entry ul { display: grid; gap: 10px; padding: 0; margin: 0; list-style: none; }
	.experience-entry li { position: relative; padding-left: 16px; color: var(--text-secondary); font-size: 15px; line-height: 1.65; }
	.experience-entry li::before { content: "—"; position: absolute; left: 0; color: var(--sand); }
	.capabilities { margin: 80px 0 0; }
	.capabilities dl { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 48px; margin: 30px 0 0; }
	.capabilities dl > div { padding: 16px 0; border-bottom: 1px solid var(--border-color); }
	.capabilities dd { margin: 8px 0 0; color: var(--text-secondary); font-size: 14px; }
	@media (max-width: 640px) { .resume-page { width: calc(100% - 32px); } .resume-intro { grid-template-columns: 1fr; padding-block: 65px; } .resume-intro > div { grid-column: 1; } .resume-intro h1 { font-size: clamp(36px, 10vw, 58px); } .experience-entry { grid-template-columns: 1fr; gap: 14px; padding-bottom: 38px; margin-bottom: 38px; } .capabilities { margin-top: 56px; } .capabilities dl { grid-template-columns: 1fr; } }
</style>
