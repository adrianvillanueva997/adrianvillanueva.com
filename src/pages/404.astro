---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";
---
<!doctype html>
<html lang="en"><head><BaseHead title={`Not found — ${SITE_TITLE}`} description="This page could not be found." noindex /></head><body><Header /><main id="main-content" class="not-found shell"><p class="eyebrow">404 / Off the route</p><h1>Nothing useful<br />buried here.</h1><p>This page doesn’t exist. The work, writing, and a way home still do.</p><a class="text-link" href="/">Back to the website <span aria-hidden="true">↗</span></a></main><Footer /></body></html>
<style>.not-found { padding-block: 90px; } h1 { margin-top: 30px; } p { max-width: 45ch; }</style>
