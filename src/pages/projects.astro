---
import { readFileSync } from "node:fs";
import { load } from "js-yaml";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";

type Project = { title: string; description: string; href?: string; repoUrl?: string; categories?: string[]; group: string };
const { projects } = load(readFileSync("src/data/projects.yaml", "utf8")) as { projects: Project[] };
---
<!doctype html><html lang="en"><head><BaseHead title={`Work — ${SITE_TITLE}`} description="A selection of systems, tools, and experiments built by Adrian Villanueva Martinez." /></head><body><Header />
<main id="main-content" class="archive-page"><header><p>01 / Work</p><h1>Selected work.</h1><p>Systems, tools, and experiments across infrastructure, data, and software.</p></header><section aria-label="Projects" class="project-list">{projects.map((project, index) => { const link = project.href || project.repoUrl; return <article><p>0{index + 1}</p><div><h2>{link ? <a href={link} target="_blank" rel="noopener noreferrer">{project.title} ↗</a> : project.title}</h2><p>{project.description}</p><small>{project.categories?.join(" · ")}</small></div></article>; })}</section></main><Footer /></body></html>
<style>
.archive-page { width:min(1000px,calc(100% - 48px)); margin:auto; }.archive-page header{padding:clamp(60px,11vw,140px) 0 80px;max-width:650px}.archive-page header>p:first-child,.project-list article>p,.project-list small{margin:0;color:var(--sand);font:400 10px/1.5 "Silkscreen",var(--font-mono);letter-spacing:.05em;text-transform:uppercase}.archive-page h1{margin:28px 0;font:400 clamp(48px,7.8vw,92px)/.96 "Silkscreen",var(--font-mono);letter-spacing:-.06em;text-transform:uppercase}.archive-page header>p:last-child{margin:0;color:var(--text-secondary);font-size:18px}.project-list{border-top:1px solid var(--border-color)}.project-list article{display:grid;grid-template-columns:80px 1fr;gap:24px;padding:28px 0;border-bottom:1px solid var(--border-color)}.project-list h2{margin:0 0 10px;font:500 clamp(23px,3vw,34px)/1.15 var(--font-body)}.project-list h2 a{color:var(--text-primary)}.project-list div>p{max-width:65ch;margin:0}.project-list small{display:block;margin-top:16px;color:var(--text-muted)}@media(max-width:640px){.archive-page{width:calc(100% - 32px)}.archive-page header{padding-block:65px}.archive-page h1{font-size:clamp(36px,10vw,58px)}.project-list article{grid-template-columns:45px 1fr;gap:12px}}
</style>
