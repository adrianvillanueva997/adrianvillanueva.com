---
import { Image } from "astro:assets";
import { readFileSync } from "fs";
import { join } from "path";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";

const images = import.meta.glob("@/assets/**/*.{png,jpg,jpeg,webp,svg}", {
	eager: true,
});

const imageMap: Record<string, any> = {};
for (const path in images) {
	const filename = path.split("/").pop();
	if (filename) imageMap[filename] = (images[path] as any).default;
}

interface Project {
	title: string;
	description: string;
	href?: string;
	imgSrc?: string;
	categories?: string[];
	group: string;
	isOpenSource?: boolean;
	repoUrl?: string;
}

const projectsPath = join(process.cwd(), "src/data/projects.yaml");
const { load } = await import("js-yaml");
const { projects } = load(readFileSync(projectsPath, "utf8")) as {
	projects: Project[];
};
const featured =
	projects.find((project) => project.title === "Zenthos") || projects[0];
const archive = projects.filter((project) => project !== featured);
const archiveGroups = [...new Set(archive.map((project) => project.group))];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects - ${SITE_TITLE}`}
			description="A selection of systems, tools, and experiments built by Adrian Villanueva Martinez."
		/>
	</head>
	<body>
		<Header />
		<main class="projects-page">
			<header class="page-intro">
				<p class="eyebrow"><span>PROJECTS / 01</span> WORKING ARCHIVE</p>
				<h1>Things I’ve<br /><em>built.</em></h1>
				<p>
					A selection of systems, tools, and experiments across data platforms,
					IoT, infrastructure, and software.
				</p>
			</header>

			{featured && (
				<section class="featured-project" aria-labelledby="featured-title">
					<div class="section-kicker"><span>02</span><h2>Featured work</h2></div>
					<div class="featured-grid">
						<div class="featured-media">
							{featured.imgSrc && imageMap[featured.imgSrc] && (
								<Image src={imageMap[featured.imgSrc]} alt={featured.title} width={800} height={540} />
							)}
							<span class="media-label">WORK / 01</span>
						</div>
						<div class="featured-copy">
							<p class="project-type">ONGOING EXPLORATION</p>
							<h2 id="featured-title">{featured.title}</h2>
							<p class="project-description">{featured.description}</p>
							{featured.isOpenSource !== undefined && (
								<span class:list={["visibility-badge", featured.isOpenSource ? "public" : "private"]}>
									{featured.isOpenSource ? "PUBLIC / OPEN SOURCE" : "PRIVATE PROJECT"}
								</span>
							)}
							<div class="project-tags">
								{featured.categories?.map((category) => <span>{category}</span>)}
							</div>
							<div class="project-links">
								{featured.repoUrl && <a class="project-link" href={featured.repoUrl} target="_blank" rel="noopener noreferrer">Source code <span>-></span></a>}
								{featured.href && <a class="project-link" href={featured.href} target="_blank" rel="noopener noreferrer">Live project <span>-></span></a>}
							</div>
						</div>
					</div>
				</section>
			)}

			{archiveGroups.map((group, groupIndex) => (
			<section class="archive" aria-labelledby={`archive-${groupIndex}`}>
				<div class="section-kicker"><span>{String(groupIndex + 3).padStart(2, "0")}</span><h2 id={`archive-${groupIndex}`}>{group}</h2></div>
				<div class="archive-list">
					{archive.filter((project) => project.group === group).map((project, index) => {
						const link = project.href || project.repoUrl;
						return (
							<article class="archive-item">
								<span class="archive-index">{String(index + 2).padStart(2, "0")}</span>
								<div class="archive-body">
									<div class="archive-heading">
										<h3>{project.title}</h3>
										{project.isOpenSource !== undefined && <span class:list={["visibility-badge", project.isOpenSource ? "public" : "private"]}>{project.isOpenSource ? "PUBLIC / OPEN SOURCE" : "PRIVATE PROJECT"}</span>}
									</div>
									<p>{project.description}</p>
									<div class="project-tags">{project.categories?.map((category) => <span>{category}</span>)}</div>
								</div>
								{link && <a class="project-link archive-link" href={link} target="_blank" rel="noopener noreferrer">{project.href ? "View project" : "Source code"} <span>-></span></a>}
							</article>
						);
					})}
				</div>
			</section>
			))}

			<section class="project-note">
				<p class="eyebrow"><span>{String(archiveGroups.length + 3).padStart(2, "0")}</span> MORE IN THE WORKS</p>
				<p>Some things are finished, some are still making noise.</p>
				<a href="/contact">Get in touch <span>-></span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects-page {
		max-width: 1120px;
		margin: 0 auto;
		padding: 3rem 2rem 1rem;
	}

	.eyebrow,
	.section-kicker > span,
	.project-type,
	.project-tags,
	.archive-index,
	.media-label {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.68rem;
		letter-spacing: 0.12em;
	}

	.eyebrow {
		color: var(--text-muted);
	}

	.eyebrow span,
	.section-kicker > span,
	.archive-index {
		color: var(--accent-blog);
	}

	.page-intro {
		max-width: 700px;
		padding: 3rem 0 8rem;
	}

	.page-intro h1 {
		margin: 1.5rem 0;
		font-size: clamp(4rem, 10vw, 8rem);
		line-height: 0.88;
		letter-spacing: -0.07em;
	}

	.page-intro h1 em {
		font-style: normal;
		color: var(--accent-blog);
	}

	.page-intro > p:last-child {
		max-width: 520px;
		color: var(--text-secondary);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.section-kicker {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 2rem;
		border-top: 1px solid var(--border-color);
		padding-top: 1rem;
	}

	.section-kicker h2 {
		margin: 0;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.9rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
		gap: clamp(2rem, 8vw, 8rem);
		align-items: center;
	}

	.featured-media {
		position: relative;
		min-height: 360px;
		background: var(--bg-tertiary);
	}

	.featured-media img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 360px;
		object-fit: cover;
		filter: saturate(0.7);
	}

	.media-label {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		padding: 0.4rem 0.6rem;
		background: var(--bg-primary);
		color: var(--accent-blog);
	}

	.featured-copy h2 {
		margin: 0.75rem 0 1rem;
		font-family: "Cinzel", serif;
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 600;
	}

	.project-type {
		margin: 0;
		color: var(--accent-blog);
	}

	.project-description,
	.archive-body p {
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
		color: var(--text-muted);
		letter-spacing: 0.04em;
	}

	.project-tags span {
		border-bottom: 1px solid var(--border-light);
		padding-bottom: 0.2rem;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}

	.project-link,
	.project-note a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--accent-blog);
		padding: 0.65rem 0.8rem;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.75rem;
		color: var(--accent-blog);
	}

	.project-link:hover {
		background: var(--accent-blog);
		color: var(--bg-primary);
	}

	.project-note a {
		border: 0;
		padding: 0;
	}

	.visibility-badge {
		display: inline-block;
		margin-top: 1.25rem;
		padding: 0.35rem 0.55rem;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.visibility-badge.public {
		border: 1px solid var(--accent-active);
		background: var(--accent-active-subtle);
		color: var(--accent-active);
	}

	.visibility-badge.private {
		border: 1px solid var(--accent-warning);
		background: color-mix(in srgb, var(--accent-warning) 10%, transparent);
		color: var(--accent-warning);
	}

	.project-note a span {
		margin-left: 0.4rem;
	}

	.archive {
		margin-top: 8rem;
	}

	.archive + .archive {
		margin-top: 5rem;
	}

	.archive-list {
		border-top: 1px solid var(--border-color);
	}

	.archive-item {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: start;
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--border-color);
	}

	.archive-heading {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.archive-heading h3 {
		margin: 0;
		font-family: "Cinzel", serif;
		font-size: clamp(1.3rem, 3vw, 2rem);
		font-weight: 600;
	}

	.archive-body p {
		max-width: 700px;
		margin: 0.5rem 0 0;
		font-size: 0.9rem;
	}

	.archive-body .project-tags {
		margin-top: 0.75rem;
	}

	.archive-link {
		align-self: center;
		white-space: nowrap;
	}

	.project-note {
		max-width: 600px;
		margin: 8rem 0 2rem auto;
		border-top: 1px solid var(--border-color);
		padding-top: 1rem;
	}

	.project-note > p:nth-child(2) {
		margin: 1.5rem 0;
		font-family: "Cinzel", serif;
		font-size: clamp(1.5rem, 3vw, 2.4rem);
		line-height: 1.25;
	}

	@media (max-width: 700px) {
		.projects-page {
			padding: 1.5rem 1rem 0;
		}

		.page-intro {
			padding: 2rem 0 5rem;
		}

		.page-intro h1 {
			font-size: clamp(3.5rem, 18vw, 6rem);
		}

		.featured-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.featured-media {
			min-height: 280px;
		}

		.featured-media img {
			min-height: 280px;
		}

		.archive,
		.project-note {
			margin-top: 5rem;
		}
	}
</style>
