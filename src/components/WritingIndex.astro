---
import { formatPostDate, loadWriting, METALOPS_RSS } from "@/utils/writing";
const posts = await loadWriting();
---
<main id="main-content" class="writing-page"><header><p>01 / Writing</p><h1>MetalOps.</h1><p>Notes on software, systems, infrastructure, and the work underneath.</p><a href={METALOPS_RSS}>Subscribe via RSS ↗</a></header><section aria-label="Published articles">{posts.map((post) => <article><time datetime={post.date}>{formatPostDate(post.date)}</time><div><h2><a href={post.link}>{post.title} ↗</a></h2><p>{post.description}</p></div></article>)}</section><p class="garden">Unfinished thoughts live in the <a href="https://brain.adrianvillanueva.com">digital garden ↗</a>.</p></main>
<style>
.writing-page{width:min(1000px,calc(100% - 48px));margin:auto}.writing-page header{padding:clamp(60px,11vw,140px) 0 80px;max-width:650px}.writing-page header>p:first-child,time{margin:0;color:var(--sand);font:400 10px/1.5 "Silkscreen",var(--font-mono);letter-spacing:.05em;text-transform:uppercase}.writing-page h1{margin:28px 0;font:400 clamp(48px,7.8vw,92px)/.96 "Silkscreen",var(--font-mono);letter-spacing:-.06em;text-transform:uppercase}.writing-page header>p:nth-child(3){font-size:18px}.writing-page header>a,.garden a{color:var(--text-primary);font:400 10px/1.5 "Silkscreen",var(--font-mono);text-decoration:underline;text-underline-offset:5px}.writing-page section{border-top:1px solid var(--border-color)}.writing-page article{display:grid;grid-template-columns:150px 1fr;gap:30px;max-width:none!important;padding:28px 0;border-bottom:1px solid var(--border-color)}.writing-page h2{margin:0 0 10px;font:500 clamp(22px,3vw,32px)/1.2 var(--font-body)}.writing-page h2 a{color:var(--text-primary)}.writing-page article p{margin:0}.garden{margin:48px 0 0;color:var(--text-muted)}@media(max-width:640px){.writing-page{width:calc(100% - 32px)}.writing-page header{padding-block:65px}.writing-page h1{font-size:clamp(36px,10vw,58px)}.writing-page article{grid-template-columns:1fr;gap:12px}}
</style>
