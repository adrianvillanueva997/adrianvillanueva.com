---
import blockedPhoto from "@/assets/files/blocked.png";
import bloqueoPhoto from "@/assets/files/bloqueo.png";
import SpainBlock from "@/components/SpainBlock.astro";
import { SOCIAL_LINKS } from "@/consts";
---
<footer class="site-footer">
	<div class="site-footer-inner">
		<div class="footer-links">
			<p>© {new Date().getFullYear()} Adrian Villanueva Martinez</p>
			<nav aria-label="Elsewhere">
				<a href={`mailto:${SOCIAL_LINKS.email}`}>Email</a>
				<a href={SOCIAL_LINKS.github}>GitHub ↗</a>
				<a href={SOCIAL_LINKS.linkedin}>LinkedIn ↗</a>
				<a href="/rss.xml">RSS</a>
			</nav>
		</div>
		<p class="disclaimer">Opinions here are my own, not my employers’.</p>
		<section class="spain-note" aria-label="About access from Spain">
			<p>Site status / Spain during football</p>
			<SpainBlock imageEs={bloqueoPhoto} imageEn={blockedPhoto} />
		</section>
	</div>
</footer>
<style>
	.site-footer { border-top: 1px solid var(--border-color); }
	.site-footer-inner { width: min(1120px, calc(100% - 48px)); margin: auto; padding-block: 22px 32px; }
	.footer-links { display: flex; justify-content: space-between; gap: 24px; }
	.site-footer p, .site-footer a { margin: 0; color: var(--text-muted); font: 400 10px/1.5 "Silkscreen", var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
	.site-footer nav { display: flex; flex-wrap: wrap; gap: 18px; }
	.site-footer a:hover { color: var(--text-primary); }
	.disclaimer { margin-top: 14px !important; }
	.spain-note { margin-top: 38px; }
	.spain-note > p { color: var(--sand); }
	.spain-note :global(.spain-block-wrapper) { justify-content: flex-start; margin-top: 14px; padding-top: 14px; }
	.spain-note :global(.spain-block) { padding: 5px; border-color: var(--border-color); background: var(--bg-primary); }
	.spain-note :global(.spain-block img) { max-width: 230px; }
	@media (max-width: 640px) { .site-footer-inner { width: calc(100% - 32px); } .footer-links { flex-direction: column; } }
</style>
