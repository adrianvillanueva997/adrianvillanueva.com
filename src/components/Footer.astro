---
import blockedPhoto from "@/assets/files/blocked.png";
import bloqueoPhoto from "@/assets/files/bloqueo.png";
import SpainBlock from "@/components/SpainBlock.astro";
import { SITE_TITLE, SOCIAL_LINKS } from "@/consts";
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-heading"><a class="footer-name" href="/">{SITE_TITLE}</a><span>Software engineer · Tokyo, Japan</span></div>
    <nav aria-label="Personal pages and elsewhere">
      <a href="/now">Now</a><a href="/uses">Uses</a><a href="/music">Music</a><a href="/resume">Résumé</a><a href="https://avm.photography">Photography ↗</a><a href="https://brain.adrianvillanueva.com">Digital garden ↗</a>
    </nav>
    <div class="footer-bottom"><small>© {new Date().getFullYear()} Adrian Villanueva Martinez</small><div><a href={`mailto:${SOCIAL_LINKS.email}`}>Email</a><a href={SOCIAL_LINKS.github}>GitHub ↗</a><a href={SOCIAL_LINKS.linkedin}>LinkedIn ↗</a><a href="/rss.xml">RSS</a><a href="https://github.com/adrianvillanueva997/adrianvillanueva.com">Source ↗</a></div></div>
    <p class="disclaimer">Opinions here are my own, not my employers’.</p>
    <details class="access-note"><summary>About access from Spain</summary><SpainBlock imageEs={bloqueoPhoto} imageEn={blockedPhoto} /></details>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--border-color); padding: 34px 0 25px; background: var(--bg-secondary); }
  .footer-inner { width: min(1240px, calc(100% - 96px)); margin: auto; }
  .footer-heading { display: flex; justify-content: space-between; gap: 20px; font-size: 13px; }
  .footer-heading span { color: var(--text-muted); font-size: 11px; }
  .footer-name { font-weight: 600; }
  nav { display: flex; flex-wrap: wrap; gap: 12px 25px; padding-block: 22px; }
  nav a { display: inline-flex; align-items: center; min-height: 32px; font-size: 12px; color: var(--text-secondary); }
  .footer-bottom { padding-top: 22px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; gap: 20px; }
  .footer-bottom small, .footer-bottom a { font-size: 10px; color: var(--text-muted); }
  .footer-bottom > div { display: flex; flex-wrap: wrap; gap: 16px; }
  .disclaimer { font-size: 10px; color: var(--text-muted); margin: 17px 0 0; }
  .access-note { font-size: 10px; color: var(--text-muted); margin-top: 12px; }
  summary { cursor: pointer; width: fit-content; padding-block: 5px; }
  @media (max-width: 768px) { .footer-inner { width: calc(100% - 40px); } .footer-heading, .footer-bottom { flex-direction: column; gap: 12px; } nav { gap: 8px 20px; } nav a { min-height: 44px; } .footer-bottom a { display: inline-flex; align-items: center; min-height: 44px; } }
</style>
