---
const primaryLinks = [
	{ label: "Work", href: "/projects" },
	{ label: "Writing", href: "/writing" },
	{ label: "About", href: "/about" },
	{ label: "Résumé", href: "/resume" },
	{ label: "Contact", href: "/contact" },
];
const moreLinks = [
	{ label: "Now", href: "/now" },
	{ label: "Uses", href: "/uses" },
	{ label: "Music", href: "/music" },
	{ label: "Photography ↗", href: "https://avm.photography" },
	{ label: "Digital garden ↗", href: "https://brain.adrianvillanueva.com" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
	href.startsWith("/") &&
	(current === href || (href === "/writing" && current === "/blog"));
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Adrian Villanueva Martinez — home">AVM<span aria-hidden="true">/</span></a>
    <span class="header-note">Software, systems<br />& stubborn curiosity.</span>
    <nav aria-label="Primary navigation">
      {primaryLinks.map(({label, href}) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
      <details class="nav-more" open={moreLinks.some(({href}) => isCurrent(href))}>
        <summary>More</summary>
        <div class="more-menu">
          {moreLinks.map(({label, href}) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
        </div>
      </details>
    </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--border-color); }
  .header-inner { width: min(1240px, calc(100% - 96px)); margin: auto; min-height: 84px; display: flex; align-items: center; gap: 32px; }
  .wordmark { font: 400 27px/1 var(--font-display); letter-spacing: -.07em; }
  .wordmark span { color: var(--sand); margin-left: 3px; }
  .header-note { font: 10px/1.6 var(--font-mono); color: var(--text-muted); }
  nav { margin-left: auto; display: flex; align-items: center; justify-content: flex-end; gap: 22px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 11px; white-space: nowrap; }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: 7px; text-decoration-color: var(--sand); }
  .nav-more { position: relative; font-size: 11px; }
  .nav-more summary { display: flex; align-items: center; min-height: 44px; cursor: pointer; list-style: none; }
  .nav-more summary::-webkit-details-marker { display: none; }
  .nav-more summary::after { content: "⌄"; margin-left: 5px; color: var(--sand); }
  .more-menu { position: absolute; z-index: 10; top: 100%; right: 0; display: grid; min-width: 180px; padding: 8px 14px; border: 1px solid var(--border-light); background: var(--bg-secondary); }
  .more-menu a { min-height: 40px; border-bottom: 1px solid var(--border-color); }
  .more-menu a:last-child { border-bottom: 0; }
  @media (max-width: 768px) {
    .header-inner { width: calc(100% - 40px); min-height: 72px; gap: 15px; }
    .header-note { display: none; }
    nav { gap: 18px; }
  }
  @media (max-width: 580px) {
    .header-inner { flex-wrap: wrap; padding-block: 12px 5px; }
    nav { width: 100%; margin: 0; justify-content: flex-start; flex-wrap: wrap; gap: 0 16px; }
    nav a { min-height: 44px; font-size: 12px; }
    .nav-more { font-size: 12px; }
    .nav-more summary { min-height: 44px; }
  }
  @media (max-width: 380px) { nav { gap: 0 14px; } .wordmark { font-size: 24px; } }
</style>
