---
const links = [
	{ label: "Work", href: "/projects" },
	{ label: "Writing", href: "/writing" },
	{ label: "About", href: "/about" },
	{ label: "Now", href: "/now" },
	{ label: "Résumé", href: "/resume" },
	{ label: "Contact", href: "/contact" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
	<div class="site-header-inner">
		<a class="site-mark" href="/" aria-label="Adrian Villanueva Martinez — home">AVM.01</a>
		<nav aria-label="Primary navigation">
			{links.map(({ label, href }) => <a href={href} aria-current={current === href ? "page" : undefined}>{label}</a>)}
		</nav>
	</div>
</header>
<style>
	.site-header { border-bottom: 1px solid var(--border-color); }
	.site-header-inner { display: flex; align-items: center; width: min(1120px, calc(100% - 48px)); min-height: 62px; margin: auto; gap: 28px; }
	.site-mark, nav a { font: 400 10px/1.4 "Silkscreen", var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
	.site-mark { color: var(--text-primary); }
	nav { display: flex; flex-wrap: wrap; gap: 20px; margin-left: auto; }
	nav a { color: var(--text-muted); }
	nav a[aria-current], nav a:hover { color: var(--text-primary); }
	nav a[aria-current] { text-decoration: underline; text-decoration-color: var(--rust); text-underline-offset: 5px; }
	@media (max-width: 640px) { .site-header-inner { width: calc(100% - 32px); min-height: 0; padding-block: 16px; align-items: start; } nav { gap: 12px 16px; } }
</style>
