---
import { Image } from "astro:assets";
import { readFileSync } from "node:fs";
import { load } from "js-yaml";
import desert from "@/assets/slopdesert.png";
import { SOCIAL_LINKS } from "@/consts";
import { formatPostDate, loadWriting } from "@/utils/writing";

const latest = (await loadWriting())[0];
const { skills } = load(readFileSync("src/data/resume.yaml", "utf8")) as {
	skills: Record<string, string[]>;
};
const stack = [
	{ label: "Languages", tools: skills.languages },
	{
		label: "Infrastructure & platforms",
		tools: [...skills.tools, ...skills.cloud],
	},
	{ label: "Observability", tools: skills.monitoring },
	{ label: "Delivery", tools: skills["CI/CD"] },
];
---

<main id="main-content" class="desert-home">
  <section class="expedition" aria-labelledby="hero-title">
    <div class="opening shell">
      <div class="name-block">
        <p class="eyebrow">Software engineer <span aria-hidden="true">/</span> Tokyo, Japan</p>
        <h1 id="hero-title"><span class="given-name">Adrian</span><span class="family-name">Villanueva Martinez</span></h1>
      </div>
      <div class="opening-copy">
        <p>I’m a software engineer specializing in data infrastructure and systems. Always interested in a good problem to solve.</p>
        <a class="text-link" href="/about">Spain → Netherlands → Tokyo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="landscape">
      <Image src={desert} alt="A ragged ratfolk caravan crosses the Slopdesert. One hauls a little cart, another reads a long note, and the lead traveler tends a faintly green device. In the distance, the Slop-O-Matic machine prints identical pages into the sky." widths={[640, 960, 1280, 1600, 2000]} sizes="(max-width: 1158px) 1200px, 100vw" format="webp" quality={82} loading="eager" fetchpriority="high" />
      <figcaption class="shell"><span>Across the AI Slopdesert</span><span>Useful machinery, carried by hand.</span></figcaption>
    </figure>
  </section>

  <section class="stack-section shell" aria-labelledby="stack-title">
    <div class="section-topline"><p class="eyebrow">01 / Tech stack</p><a class="text-link" href="/resume">Experience & résumé <span aria-hidden="true">↗</span></a></div>
    <div class="stack-grid">
      <div class="stack-intro"><h2 id="stack-title">Tech stack.</h2><p>The languages, platforms, and tools I work with.</p></div>
      <dl class="stack-inventory">{stack.map(({ label, tools }) => <div><dt>{label}</dt><dd><ul>{tools.map((tool) => <li>{tool}</li>)}</ul></dd></div>)}</dl>
    </div>
  </section>

  <section class="journal" aria-labelledby="writing-title">
    <div class="shell journal-grid">
      <div class="journal-heading"><p class="eyebrow">02 / Writing</p><h2 id="writing-title">MetalOps<span aria-hidden="true">.</span></h2><p>Technical writing by Adrian Villanueva.</p><p class="journal-description">Systems, experiments, and explanations of the machinery.</p><a class="text-link" href="/writing">All writing <span aria-hidden="true">↗</span></a></div>
      {latest && <article class="latest-article"><p class="eyebrow">Latest entry <span aria-hidden="true">/</span> <time datetime={latest.date}>{formatPostDate(latest.date)}</time></p><h3><a href={latest.link}>{latest.title}<span aria-hidden="true"> ↗</span></a></h3><p>{latest.description}</p><a class="text-link" href={latest.link}>Read on MetalOps <span aria-hidden="true">↗</span></a></article>}
    </div>
    <div class="shell garden-line"><span class="eyebrow">Still taking shape</span><p>Unfinished thoughts live in the <a href="https://brain.adrianvillanueva.com">digital garden ↗</a>, separate from published articles.</p></div>
  </section>

  <section class="home-contact shell" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">03 / Contact</p>
    <h2 id="contact-title">Get in touch.</h2>
    <div class="contact-row"><a class="email-link" href={`mailto:${SOCIAL_LINKS.email}`}>{SOCIAL_LINKS.email} <span aria-hidden="true">↗</span></a><div class="contact-social"><a href={SOCIAL_LINKS.github}>GitHub ↗</a><a href={SOCIAL_LINKS.linkedin}>LinkedIn ↗</a></div></div>
  </section>
</main>
