---
const { imageEs, imageEn } = Astro.props;
const URL = "https://x.com/Manz/status/1893709639125987637";

// Get src strings for client-side use
const srcEs = imageEs?.src ?? imageEs;
const srcEn = imageEn?.src ?? imageEn;
---

<div class="spain-block-wrapper" id="spain-block-wrapper">
  <div class="spain-block">
    <a href={URL} target="_blank" rel="noopener noreferrer" class="image-link">
      <img id="spain-block-img" src={srcEn} alt="This website is blocked in Spain when there is football." />
    </a>
  </div>
</div>

<script define:vars={{ srcEs, srcEn }}>
  const img = document.getElementById('spain-block-img');

  // Language detection
  const isSpanish = navigator.language.startsWith('es');
  if (isSpanish && img) {
    img.src = srcEs;
    img.alt = "Este sitio web es bloqueado en España cuando hay fútbol";
  }
</script>

<style>
  .spain-block-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    width: 100%;
  }

  .spain-block {
    position: relative;
    display: inline-block;
    border: 1px solid var(--border-light);
    background: var(--bg-tertiary);
    padding: 0.75rem;
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
  }

  .spain-block:hover {
    border-color: var(--accent-active);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 20px var(--accent-active-glow);
  }

  .image-link {
    display: block;
    line-height: 0;
  }

  .spain-block img {
    max-width: 300px;
    height: auto;
    display: block;
    border-radius: var(--radius-sm);
    opacity: 1;
    transition: all 0.3s ease;
    border: none;
  }

  .spain-block:hover img {
    transform: scale(1.02);
  }

</style>
